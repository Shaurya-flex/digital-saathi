# ============================================================
# Digital Saathi — environment variables
# Copy to .env.local and fill in what you have. Every adapter
# runs as a labelled mock until its key is present (see
# docs/ADAPTERS.md). No key is ever sent to the browser.
# ============================================================

# Database (Neon serverless Postgres)
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# LLM adapters — model id per routing tier (see src/lib/adapters/llm.ts)
SAATHI_LLM_LIGHT=
SAATHI_LLM_STANDARD=
SAATHI_LLM_REASONING=
SAATHI_LLM_VISION=
SAATHI_LLM_SPEECH=
SAATHI_LLM_COMPUTER=
ANTHROPIC_API_KEY=

# Payments (server-side only — never expose to the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Recharge / Bills
SAATHI_RECHARGE_KEY=
SAATHI_BBPS_KEY=

# Travel
SAATHI_TRAVEL_KEY=

# Appointments
SAATHI_APPT_KEY=

# Notifications
SAATHI_SMS_KEY=
SAATHI_WA_TOKEN=
RESEND_API_KEY=

# Storage (S3 / Cloudflare R2)
SAATHI_STORAGE_KEY=
SAATHI_STORAGE_BUCKET=

# Realtime (Pusher)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Analytics
POSTHOG_KEY=

# Maps
SAATHI_MAPS_KEY=

# Web search
SAATHI_SEARCH_KEY=

# Browser automation / computer use
SAATHI_OPERATOR_KEY=

# OTP auth
FAST2SMS_KEY=

# Build flags
# SAATHI_STATIC_EXPORT=1   # static export (GitHub Pages)
# SAATHI_BASE_PATH=/digital-saathi
